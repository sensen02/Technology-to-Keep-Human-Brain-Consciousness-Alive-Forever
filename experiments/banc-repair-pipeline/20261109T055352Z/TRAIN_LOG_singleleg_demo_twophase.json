  "prereg_amendment_2": {
    "schema": "banc-repair-pipeline/1-amendment-2",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json (acceptance criteria unchanged)",
    "when": "after the imitation-only run, before the demo-initialised PPO run",
    "evidence": {
      "imitation_only": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/TRAIN_LOG_singleleg_demo.json",
      "reward_scale": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/REWARD_SCALE.json",
      "observed": "with a screened lift direction as the teacher and ZERO PPO updates, five of six legs already reach unload + lift + advance (LF lift 0.0877, LM 1.4083, RF 0.1963, LH 0.7414, RH 0.0739); every leg fails only the 'place' criterion because the foot is still up at the end of the episode",
      "diagnosis": "the declared level-based task reward pays unload+lift continuously, about 2 per tick, while placing is a single event bonus of 2. Holding the foot up for the remaining ticks therefore out-returns placing it, so the reward itself forbids the behaviour the acceptance test requires. This is a defect in my reward design, not a capability finding."
    },
    "reward_changes": {
      "task_terms": {
        "old": "level: 0.8*unload + 1.2*lift + 1.0*advance_rate, paid every tick",
        "new": "potential: phi = 0.8*unload + 1.2*lift + 1.0*clip(best_advance/0.03); reward = gamma*phi' - phi",
        "reason": "potential-based shaping telescopes, so a held state pays nothing and only progress pays"
      },
      "place_hold": {
        "old": 0.0,
        "new": 0.6,
        "reason": "dense credit for being loaded again at pad height <= 0.004 after a completed swing, so the terminal placement is not a single sparse event"
      }
    },
    "unchanged": {
      "acceptance_criteria": "unload 0.10 W, lift 0.015, advance 0.03, place 0.10 W and padz 0.004, safety support 0.90 / non-foot 4.889 W / COM 1.00",
      "safety_penalties": "non-foot 20, support 30, COM 60, other-leg stance 0.05, action 0.02, omega 0.01, gravity 0.01",
      "place_event_bonus": 2.0,
      "optimizer": "unchanged cumulative-KL budget, 24 updates, rollout 1024",
      "preregistered_outcomes": "unchanged"
    },
    "discipline": "PREREG.json and PREREG_AMENDMENT_1.json are left byte-identical"
  },
  "prereg_amendment_3": {
    "schema": "banc-repair-pipeline/1-amendment-3",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json (acceptance criteria unchanged)",
    "supersedes_reward_form": "PREREG_AMENDMENT_2.json (potential-based shaping is kept, its potential is fixed)",
    "when": "after the first potential-based run reached update 13 without placing, before the next run",
    "evidence": {
      "run": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/train_singleleg_demo_levels.log",
      "evaluation_at_update_8": "LF lift 0.0830 advance 0.3067 but final load 0.000; LM lift 1.4237 advance 0.5825 final load 0.000; RF lift 0.2054 advance 0.0849 final load 0.000",
      "diagnosis": "the potential was built from instantaneous levels, so the state 'foot held in the air' has phi about 3.0 while the state 'step completed and foot back down' has phi about 1.0. Telescoped shaping therefore still prefers ending the episode with the foot up, which is exactly what every evaluation shows."
    },
    "reward_changes": {
      "potential": {
        "old": "0.8*unload_level + 1.2*lift_level + 1.0*clip(best_advance/0.03)",
        "new": "0.8*did_unload + 1.2*did_lift + 1.0*clip(best_advance/0.03) + 2.0*placed",
        "reason": "achievement flags stay set once reached, so completing and placing the foot strictly dominates holding it up; best_advance was already monotone"
      }
    },
    "unchanged": {
      "acceptance_criteria": "unload 0.10 W, lift 0.015, advance 0.03, place 0.10 W and padz 0.004, safety support 0.90 / non-foot 4.889 W / COM 1.00",
      "safety_penalties": "unchanged",
      "place_hold": 0.6,
      "place_event_bonus": 2.0,
      "optimizer_and_budget": "unchanged",
      "warm_start": "unchanged: screened lift direction of the prompted leg while it carries load"
    },
    "discipline": "amendments 1 and 2 are left byte-identical; this file records the third change, its measurement and its reason. Reward design has now been changed three times inside this round, each time from a measured degeneracy, which the final report states explicitly"
  },
  "prereg_amendment_4": {
    "schema": "banc-repair-pipeline/1-amendment-4",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json (acceptance criteria unchanged)",
    "when": "after the 64-update run, before the next run; found by comparing the training gates with the evaluator",
    "evidence": {
      "training_placement_rate": "placed_fraction reached a maximum of 0.814 and averaged 0.247 over the last eight updates of the 64-update run",
      "evaluation_end_load": "the same checkpoint ends the deterministic episode with 0.000 to 0.041 body weight on the prompted leg",
      "codes": "train_single_leg.py before this amendment used HIGH = 0.30 * body weight to close a swing and to set the 'placed' flag, while evaluate() calls a leg placed at THRESH['place_load'] = 0.10 * body weight",
      "diagnosis": "the training signal for landing required three times the load that the acceptance test requires, so the dense 'placed' credit was gated behind a state almost never reached (a leg at rest carries about 0.17 body weight). This is a mismatch between my reward code and my own declared criteria, not a capability limit."
    },
    "changes": {
      "swing_start": {
        "old": "load <= 0.10 * body weight",
        "new": "load <= 0.05 * body weight",
        "reason": "hysteresis: the swing must start below the acceptance unload bar so that closing at 0.10 cannot chatter at the boundary"
      },
      "swing_end": {
        "old": "load >= 0.30 * body weight",
        "new": "load >= 0.10 * body weight AND pad bottom height <= 0.004",
        "reason": "this is exactly the acceptance definition of a placement"
      },
      "placed_flag": {
        "old": "max lift >= 0.008 and load >= 0.30 * body weight",
        "new": "max lift >= 0.008 and advanced >= 0.03 and closed at load >= 0.10 with pad <= 0.004",
        "reason": "the advance requirement moves from a multiplier on the bonus into a gate, so the bonus is no longer paid for a swing that barely moved"
      },
      "evaluator": {
        "old": "closed a swing at 0.30 * body weight",
        "new": "closed at 0.10 * body weight with pad <= 0.004",
        "reason": "training and evaluation must share one definition of a swing, otherwise the numbers are not comparable"
      }
    },
    "unchanged": {
      "acceptance_criteria": "unload 0.10 W, lift 0.015, advance 0.03, place 0.10 W and padz 0.004, safety support 0.90 / non-foot 4.889 W / COM 1.00",
      "reward_weights": "0.8 / 1.2 / 1.0 / place 2.0 / place_hold 0.6 and all safety penalties",
      "potential_form": "achievement flags (PREREG_AMENDMENT_3.json)",
      "warm_start_and_optimizer": "unchanged, 24 updates, 300-tick window"
    },
    "discipline": "amendments 1, 2 and 3 and the original PREREG are left byte-identical; this is the fourth documented reward change in the round and the report lists all four with their measurements"
  },
  "prereg_amendment_5": {
    "schema": "banc-repair-pipeline/1-amendment-5",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "the warm-start teacher only; PREREG.json and all acceptance criteria unchanged",
    "when": "after the acceptance-aligned gate run, before the next run",
    "evidence": {
      "four_arms_compared": {
        "300ms_24u": "LF lift 0.0214-0.0448, end load 0.036-0.041 (never lifts and lands together)",
        "300ms_64u": "LF lift 0.0035, end load 0.041; RM end load 0.123 but lift 0.0019",
        "500ms_24u": "LF end load 0.054 but COM fell to 0.858",
        "300ms_24u_aligned_gates": "LF lift 0.1475, end load 0.000; RM end load 0.103 but lift 0.000"
      },
      "pattern": "in every arm each leg does one half of the step and never both: the deterministic policy emits what is effectively a constant action for the whole 300 ms episode, so it either holds the foot up or presses it down",
      "diagnosis": "the previous teacher was itself constant (the screened lift direction for the whole swing), so supervised initialisation could only ever teach a constant action. A sequence cannot come out of a teacher that has no second phase."
    },
    "teacher_changes": {
      "form": {
        "old": "command the screened lift direction while the leg carries load, else zero",
        "new": "two phases selected by measured state: lift while the leg carries load, keep lifting while the leg has travelled less than half the commanded travel, then command the mirrored (press) direction"
      },
      "switch_signal": {
        "old": "foot load only",
        "new": "foot load, then the fraction of commanded joint travel already achieved",
        "reason": "the 183-feature sensory vector contains joint angles, tracking error, velocities, targets, foot loads, gravity and body velocities but NOT the pad height, so a pad-height switch would be unobservable to the network being taught. The joint excursion is observable."
      },
      "declared_limits": "this teacher is a rule-based demonstration generator. The deployed artefact remains the network, which is fine-tuned by PPO with the teacher absent. Nothing in this amendment may be reported as connectome capability, and any result must be labelled 'network initialised from a declared two-phase demonstration'."
    },
    "unchanged": {
      "acceptance_criteria": "identical",
      "reward": "achievement flags, aligned swing gates (PREREG_AMENDMENT_4.json), unchanged weights",
      "optimizer_and_window": "unchanged, 24 updates, 300 ticks",
      "preregistered_outcomes": "identical"
    },
    "discipline": "amendments 1-4 and the original PREREG are left byte-identical. This is the fifth documented change of the round: four reward or gate changes and one teacher change, each with its measurement. The report states all five explicitly."
  },
