{
  "prereg": {
    "schema": "banc-repair-pipeline/1",
    "created_runtime_utc": "20261109T055352Z",
    "motivation": "The audit at experiments/banc-control-audit/20261109T053534Z found that (a) the actuator's own 2 rad/s rate limit masked most policy output in the legacy interface, (b) training, evaluation and the renderer each ran a different base-network/observation schedule, (c) the 294 history features were the frozen base network's own predictions rather than the agent's commands, (d) the six foot loads reached the sensory encoder in a different leg order than the encoder declares, (e) PPO used no bootstrap at time-limit truncation and a cumulative rather than windowed slip cost, and (f) the pad-clearance lookup still used a single-pad exact name on a three-sphere body.",
    "what_changes": [
      "one control path: repair_core.Core is used by the probe, the trainer and (later) the renderer; nothing else implements a schedule",
      "the policy owns the full actuator authority: rate = action * 2.0 rad/s, the actuator's own limit, so no saturated tracking term can mask it; the frozen base network is demoted to warm-start data only and never acts at evaluation",
      "the 294 history features are the last 7 own commanded targets over a 40-tick ring buffer",
      "foot loads are handed to the sensory encoder in its declared order LF LM LH RF RM RH",
      "pad geometry is found by prefix over all three triad spheres per leg",
      "PPO: bootstrap at time-limit truncation, discount and GAE declared as a time horizon, per-step slip cost with a fixed window, signed forward velocity"
    ],
    "what_does_not_change": [
      "the four frozen walking gates (support min >= 0.90, non-foot <= 4.889 W, COM >= 1.20, per-leg slip ratio <= 0.50) are not touched and are not the target of this round",
      "the derived triad body, doubled actuator range, mu = 1.5 and the releasable adhesion law stay as declared derived models with their existing hashes",
      "no connectome topology, neuron identity or synapse is modified in this round",
      "no injury experiment"
    ],
    "round_1_target": "single-leg unload-lift-place on the repaired pipeline, measured on all six legs. This is the capability the audit identified as missing; it is a prerequisite for stepping and is not walking.",
    "task_definition": {
      "episode_ticks": 300,
      "episode_ms": 300,
      "prompt": "one-hot over 6 legs, supplied as a declared task instruction input (6 dims), re-drawn per episode; no clock, no phase, no external gait generator",
      "start_state": "cold start from the solved triad stand pose (COM 1.3008 static), identical for every episode",
      "success_criteria_all_required": {
        "unload": "min load on the prompted leg <= 0.10 * body weight",
        "lift": "max pad bottom height on the prompted leg >= 0.015 native",
        "advance": "max forward (thorax +x) displacement of the prompted foot during the swing >= 0.03 native",
        "place": "at episode end the prompted leg carries >= 0.10 * body weight with pad bottom height <= 0.004",
        "safe": "support min >= 0.90, non-foot peak <= 4.889 W, COM min >= 1.00 (stage threshold, declared weaker than the 1.20 walking gate)"
      },
      "reported_not_gated": "other-leg stance slip, signed forward velocity, per-leg lift and advance figures"
    },
    "reward_declared_weights": {
      "unload": 0.8,
      "lift": 1.2,
      "advance_rate": 1.0,
      "place_event": 2.0,
      "nonfoot": 20.0,
      "support_shortfall": 30.0,
      "com_shortfall": 60.0,
      "other_leg_stance_excess": 2.0,
      "action_magnitude": 0.02,
      "omega": 0.05,
      "gravity_tilt": 0.01
    },
    "optimizer": {
      "algorithm": "PPO, numpy, hand-written gradients plus Adam",
      "updates": 48,
      "rollout_ticks": 1024,
      "epochs": 4,
      "minibatch": 64,
      "lr": 0.0003,
      "clip": 0.2,
      "value_coef": 0.5,
      "grad_norm": 0.5,
      "target_kl": 0.03,
      "logstd_bounds": [
        -5.0,
        -1.5
      ],
      "initial_logstd": -3.0,
      "discount_halflife_s": 1.0,
      "gae_lambda": 0.99,
      "warm_start": "supervised regression of the actor mean onto the frozen base network's rate command (clip(base_rate/2, -1, 1)) over teacher rollouts; the base network is our own frozen artifact, used as initialisation only"
    },
    "preregistered_outcomes": {
      "if_all_six_legs_pass": "the repaired interface can produce a single supervised-instructed step; next round may train autonomous leg selection and continuous slow walking, still without any clock or external gait generator",
      "if_unload_and_lift_pass_but_advance_or_place_fail": "the body can release and raise a foot but cannot transport or replant it; next diagnosis is the swing trajectory and the actuator's usable workspace, not the reward scale",
      "if_lift_never_appears": "check whether the requested joint-rate authority still exceeds what the leg needs, then whether the adhesion releases; do not raise the actuator limit before that check",
      "if_safety_fails_only": "the single-leg action is achievable but destabilising; next step is a balance/support constraint, not more reward hacking",
      "no_result_may_be_reported_as_walking": true
    },
    "labelling": "derived body, derived actuator range, derived adhesion, replacement ANN with a task instruction input. Never frozen-body acceptance and never a connectome capability."
  },
  "prereg_amendment": {
    "schema": "banc-repair-pipeline/1-amendment-1",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json",
    "when": "before the main 48-update run, after a measured reward-scale probe",
    "evidence": {
      "script": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/reward_scale.py",
      "result": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/REWARD_SCALE.json",
      "measured_on": "warm-start policy, 6 prompts x 300 ticks, zero PPO updates",
      "mean_term_values": {
        "unload": 0.229,
        "lift": 0.0069,
        "nonfoot": -0.00016,
        "support": 0.0,
        "com": 0.0,
        "other_stance": -6.53,
        "act": -0.0101,
        "omega": -0.447,
        "grav": -2.5e-05
      },
      "mean_total_reward": -6.756,
      "interpretation": "the summed stance-slip penalty was 6.53 per tick against 0.236 of combined task reward, i.e. about 28 times larger. Raw summed stance excess averaged 3.27 native/s across the other five legs, which is the same slipping that the earlier line of work found the policy cannot reduce on planted feet. Running with the original weight would have re-created the stand-still degeneracy instead of testing whether a single leg can be lifted."
    },
    "weight_changes": {
      "other_leg_stance_excess": {
        "old": 2.0,
        "new": 0.05,
        "reason": "demoted from a driver to a reported quantity; slip remains measured and reported but must not dominate a task that is not about slip yet"
      },
      "omega": {
        "old": 0.05,
        "new": 0.01,
        "reason": "body angular-rate penalty was 0.447 per tick, twice the task terms"
      }
    },
    "unchanged": {
      "task_terms": "unload 0.8, lift 1.2, advance_rate 1.0, place_event 2.0",
      "safety_terms": "nonfoot 20, support 30, com 60",
      "success_criteria": "the five pre-registered criteria are untouched",
      "optimizer": "48 updates, rollout 1024, epochs 4, lr 3e-4, gamma half-life 1.0 s, GAE 0.99",
      "preregistered_outcomes": "unchanged, including that no result may be reported as walking"
    },
    "discipline": "the original PREREG.json is left byte-identical; this amendment records what changed, why, and the measurement that justified it before the run started"
  },
  "prereg_amendment_2": {
    "schema": "banc-repair-pipeline/1-amendment-2",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json (acceptance criteria unchanged)",
    "when": "after the imitation-only run, before the demo-initialised PPO run",
    "evidence": {
      "imitation_only": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/TRAIN_LOG_singleleg_demo.json",
      "reward_scale": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/REWARD_SCALE.json",
      "observed": "with a screened lift direction as the teacher and ZERO PPO updates, five of six legs already reach unload + lift + advance (LF lift 0.0877, LM 1.4083, RF 0.1963, LH 0.7414, RH 0.0739); every leg fails only the 'place' criterion because the foot is still up at the end of the episode",
      "diagnosis": "the declared level-based task reward pays unload+lift continuously, about 2 per tick, while placing is a single event bonus of 2. Holding the foot up for the remaining ticks therefore out-returns placing it, so the reward itself forbids the behaviour the acceptance test requires. This is a defect in my reward design, not a capability finding."
    },
    "reward_changes": {
      "task_terms": {
        "old": "level: 0.8*unload + 1.2*lift + 1.0*advance_rate, paid every tick",
        "new": "potential: phi = 0.8*unload + 1.2*lift + 1.0*clip(best_advance/0.03); reward = gamma*phi' - phi",
        "reason": "potential-based shaping telescopes, so a held state pays nothing and only progress pays"
      },
      "place_hold": {
        "old": 0.0,
        "new": 0.6,
        "reason": "dense credit for being loaded again at pad height <= 0.004 after a completed swing, so the terminal placement is not a single sparse event"
      }
    },
    "unchanged": {
      "acceptance_criteria": "unload 0.10 W, lift 0.015, advance 0.03, place 0.10 W and padz 0.004, safety support 0.90 / non-foot 4.889 W / COM 1.00",
      "safety_penalties": "non-foot 20, support 30, COM 60, other-leg stance 0.05, action 0.02, omega 0.01, gravity 0.01",
      "place_event_bonus": 2.0,
      "optimizer": "unchanged cumulative-KL budget, 24 updates, rollout 1024",
      "preregistered_outcomes": "unchanged"
    },
    "discipline": "PREREG.json and PREREG_AMENDMENT_1.json are left byte-identical"
  },
  "prereg_amendment_3": {
    "schema": "banc-repair-pipeline/1-amendment-3",
    "created_runtime_utc": "20261109T055352Z",
    "amends": "PREREG.json (acceptance criteria unchanged)",
    "supersedes_reward_form": "PREREG_AMENDMENT_2.json (potential-based shaping is kept, its potential is fixed)",
    "when": "after the first potential-based run reached update 13 without placing, before the next run",
    "evidence": {
      "run": "/run/media/sensen/Data2/cell_wound_prototype/experiments/banc-repair-pipeline/20261109T055352Z/train_singleleg_demo_levels.log",
      "evaluation_at_update_8": "LF lift 0.0830 advance 0.3067 but final load 0.000; LM lift 1.4237 advance 0.5825 final load 0.000; RF lift 0.2054 advance 0.0849 final load 0.000",
      "diagnosis": "the potential was built from instantaneous levels, so the state 'foot held in the air' has phi about 3.0 while the state 'step completed and foot back down' has phi about 1.0. Telescoped shaping therefore still prefers ending the episode with the foot up, which is exactly what every evaluation shows."
    },
    "reward_changes": {
      "potential": {
        "old": "0.8*unload_level + 1.2*lift_level + 1.0*clip(best_advance/0.03)",
        "new": "0.8*did_unload + 1.2*did_lift + 1.0*clip(best_advance/0.03) + 2.0*placed",
        "reason": "achievement flags stay set once reached, so completing and placing the foot strictly dominates holding it up; best_advance was already monotone"
      }
    },
    "unchanged": {
      "acceptance_criteria": "unload 0.10 W, lift 0.015, advance 0.03, place 0.10 W and padz 0.004, safety support 0.90 / non-foot 4.889 W / COM 1.00",
      "safety_penalties": "unchanged",
      "place_hold": 0.6,
      "place_event_bonus": 2.0,
      "optimizer_and_budget": "unchanged",
      "warm_start": "unchanged: screened lift direction of the prompted leg while it carries load"
    },
    "discipline": "amendments 1 and 2 are left byte-identical; this file records the third change, its measurement and its reason. Reward design has now been changed three times inside this round, each time from a measured degeneracy, which the final report states explicitly"
  },
