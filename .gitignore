# ---- DERIVED / REGENERABLE: never commit ----
# PyTorch + FlyGym environments (680 MB + 737 MB).  Reproduce with the pinned requirements.
venv/
venv_body/
.venv/
# Third-party payloads checked out locally (3.7 GB), including pyVertexModel which no code in
# this repository references.  Kept on disk by the owner's choice; NOT part of the source.
vendor/
# Downloaded datasets and model assets (14 GB).  These are inputs, not source; each is cited
# in its own provenance sidecar under sources/ or outputs/.
data/
# Measurement outputs: recordings, frames, npz, figures (2.1 GB).  Samples are delivered to the
# Desktop separately; the repository keeps the CODE and the small JSON reports.
outputs/
upstream/
__pycache__/
*.pyc
*.pyo
MUJOCO_LOG.TXT

# ---- SECRETS: must never be committed or served ----
.flywire_api_token
.flywire_cookies.txt
*.token
*.cookies.txt

# ---- large binary media that can be regenerated ----
*.png
*.jpg
*.jpeg
*.mp4
*.gif
*.mov
*.avi
*.webm
*.npy
*.npz
*.parquet
*.feather
*.pkl
*.swc
*.headers
*.head

# ---- experiment payloads: per-run evidence stays on disk, not in git ----
# `experiments/` keeps the CODE and the small JSON/markdown evidence.  The following are
# either reproducible environments, downloaded inputs, trained weights, native-step
# recordings or nested checkouts; each is cited by absolute path + sha256 inside the run's
# IDENTITY.json / RESULT.json, so the repository does not need to carry the bytes.
experiments/**/env/
experiments/**/.venv/
experiments/**/.venv*/
experiments/**/flight_env/
experiments/**/site-packages/
experiments/**/node_modules/
experiments/**/.git/
# Virtualenv interpreters link to the host python; never archive them.
experiments/**/env/bin/
experiments/**/.venv/bin/
*.pt
*.pth
*.safetensors
*.ckpt
*.h5
*.hdf5
*.zip
*.tar
*.tar.*
*.zst
*.7z
*.mjb
*.mjbx
*.so
*.dylib
*.a
# Full 12.5 us native-step streams (GB scale, one directory per recording run).
experiments/**/native/
# Downloaded measurement datasets; provenance sidecars keep the hashes.
references/**/*.zip
references/**/*.hdf5
references/**/*.h5

# Third-party checkout under an experiment run; provenance is its own SOURCE.json + commit id.
experiments/**/official-flybody/
experiments/**/deps/*.whl
experiments/**/20261120T041127Z-dual-eye-splats/brush-*/
experiments/**/20261120T041127Z-dual-eye-splats/cv/
experiments/**/20261117T235930Z-ascending-reference-fit/sources/*.html

# Per-step / per-worker experiment payloads.  Keep the compact RESULT / FINAL /
# REPORT files, but regenerate these from the checked-in scripts and manifests.
experiments/**/TRANSPORT.json
experiments/**/SOURCE_QUEUE.json
experiments/**/*.jsonl
experiments/**/*.log
experiments/**/*.exit
experiments/**/*.out
experiments/**/worker_*/
experiments/**/terrain_identity/
experiments/**/logs/*.lock
experiments/**/*.prof
experiments/**/20261121T044921Z-twenty-food-teachers/live-*-on-previous
experiments/**/saved_model.pb
experiments/**/variables/

# Large generated diagnostics and duplicated run snapshots.  The concise RESULT,
# FINAL, REPORT and checked-in programs remain the reviewable experiment record.
# JSON evidence remains in the immutable local experiment directories; only the
# explicitly curated current/final summaries are force-added to git.
experiments/**/*.json
experiments/**/*.json_*
experiments/**/*.csv
experiments/**/*.tsv
experiments/**/CAPTURES.json
experiments/**/*QUEUE.json
experiments/**/STAT.json
experiments/**/CANDIDATE_GRAPH.json
experiments/**/IDENTITY.json
experiments/**/PREFLIGHT.json
